n  color: #dc2626;\r\n  background: #fee2e2;\r\n}\r\n.diff-tag.new {\r\n  color: #16a34a;\r\n  background: #dcfce7;\r\n}\r\n.diff-pre {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;\r\n  white-space: pre-wrap;\r\n  word-break: break-all;\r\n  color: #374151;\r\n  line-height: 1.5;\r\n}\r\n</style>\r\n"]}]}