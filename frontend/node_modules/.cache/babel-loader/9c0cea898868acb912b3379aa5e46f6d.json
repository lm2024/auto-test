,\n      currentLog: null,\n      aiVisible: false,\n      aiResult: null,\n      aiLoading: false,\n      viewMode: 'flat',\n      ws: null\n    };\n  },\n  computed: {\n    currentLogDesc: function currentLogDesc() {\n      if (!this.currentLog) return [];\n      return [{\n        label: '节点编码',\n        value: this.currentLog.nodeCode\n      }, {\n        label: '状态',\n        value: this.statusText(this.currentLog.status)\n      }, {\n        label: '请求方法',\n        value: this.currentLog.requestMethod\n      }, {\n        label: '响应码',\n        value: this.currentLog.responseCode\n      }, {\n        label: '耗时',\n        value: this.currentLog.costMs + 'ms'\n      }];\n    },\n    traceLogGroups: function traceLogGroups() {\n      var grouped = {};\n      var order = [];\n      this.nodeLogs.forEach(function (log) {\n        var traceId = log.bizOperTraceId || '__ungrouped__';\n        if (!grouped[traceId]) {\n          grouped[traceId] = {\n            traceId: traceId,\n            logs: []\n          };\n          order.push(traceId);\n        }\n        grouped[traceId].logs.push(log);\n      });\n      return order.map(function (id) {\n        return grouped[id];\n      });\n    }\n  },\n  mounted: function mounted() {\n    this.executionId = this.$route.params.executionId;\n    this.loadData();\n    this.connectWs();\n  },\n  beforeDestroy: function beforeDestroy() {\n    if (this.ws) this.ws.close();\n  },\n  methods: {\n    loadData: function () {\n      var _loadData = _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var res, logRes;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.n) {\n            case 0:\n              _context.n = 1;\n              return api.get('/execute/status', {\n                params: {\n                  executionId: this.executionId\n                }\n              });\n            case 1:\n              res = _context.v;\n              this.mainI