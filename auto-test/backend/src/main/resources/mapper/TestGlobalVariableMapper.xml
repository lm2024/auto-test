<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autotest.mapper.TestGlobalVariableMapper">

    <resultMap id="BaseResultMap" type="com.autotest.model.entity.TestGlobalVariable">
        <id column="id" property="id"/>
        <result column="var_scope" property="varScope"/>
        <result column="chain_code" property="chainCode"/>
        <result column="var_name" property="varName"/>
        <result column="var_value" property="varValue"/>
        <result column="var_type" property="varType"/>
        <result column="is_encrypted" property="isEncrypted"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO test_global_variable
            (var_scope, chain_code, var_name, var_value, var_type, is_encrypted, description)
        VALUES
            (#{varScope}, #{chainCode}, #{varName}, #{varValue}, #{varType}, #{isEncrypted}, #{description})
    </insert>

    <update id="update">
        UPDATE test_global_variable
        <set>
            <if test="varScope != null">var_scope = #{varScope},</if>
            <if test="chainCode != null">chain_code = #{chainCode},</if>
            <if test="varName != null">var_name = #{varName},</if>
            <if test="varValue != null">var_value = #{varValue},</if>
            <if test="varType != null">var_type = #{varType},</if>
            <if test="isEncrypted != null">is_encrypted = #{isEncrypted},</if>
            <if test="description != null">description = #{description},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM test_global_variable WHERE id = #{id}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM test_global_variable WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT * FROM test_global_variable
        <where>
            <if test="scope != null and scope != ''">
                AND var_scope = #{scope}
            </if>
            <if test="chainCode != null and chainCode != ''">
                AND chain_code = #{chainCode}
            </if>
        </where>
        ORDER BY var_scope ASC, chain_code ASC, var_name ASC
    </select>

    <select id="selectGlobalList" resultMap="BaseResultMap">
        SELECT * FROM test_global_variable WHERE var_scope = 'GLOBAL' ORDER BY var_name ASC
    </select>

    <select id="selectChainList" resultMap="BaseResultMap">
        SELECT * FROM test_global_variable
        WHERE var_scope = 'CHAIN' AND chain_code = #{chainCode}
        ORDER BY var_name ASC
    </select>
</mapper>
