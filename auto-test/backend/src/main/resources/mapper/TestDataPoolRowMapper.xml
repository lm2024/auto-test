<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autotest.mapper.TestDataPoolRowMapper">

    <resultMap id="BaseResultMap" type="com.autotest.model.entity.TestDataPoolRow">
        <id column="id" property="id"/>
        <result column="pool_id" property="poolId"/>
        <result column="row_index" property="rowIndex"/>
        <result column="row_data" property="rowData"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO test_data_pool_row (pool_id, row_index, row_data)
        VALUES (#{poolId}, #{rowIndex}, #{rowData})
    </insert>

    <insert id="batchInsert">
        INSERT INTO test_data_pool_row (pool_id, row_index, row_data)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.poolId}, #{item.rowIndex}, #{item.rowData})
        </foreach>
    </insert>

    <update id="update">
        UPDATE test_data_pool_row
        <set>
            <if test="rowData != null">row_data = #{rowData},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM test_data_pool_row WHERE id = #{id}
    </delete>

    <delete id="deleteByPoolId">
        DELETE FROM test_data_pool_row WHERE pool_id = #{poolId}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM test_data_pool_row WHERE id = #{id}
    </select>

    <select id="selectByPoolId" resultMap="BaseResultMap">
        SELECT * FROM test_data_pool_row
        WHERE pool_id = #{poolId}
        ORDER BY row_index ASC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="selectByPoolIdAndRowIndex" resultMap="BaseResultMap">
        SELECT * FROM test_data_pool_row
        WHERE pool_id = #{poolId} AND row_index = #{rowIndex}
        LIMIT 1
    </select>

    <select id="countByPoolId" resultType="int">
        SELECT COUNT(*) FROM test_data_pool_row WHERE pool_id = #{poolId}
    </select>
</mapper>
