<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autotest.mapper.NodeSnapshotMapper">

    <resultMap id="BaseResultMap" type="com.autotest.model.entity.NodeSnapshot">
        <id column="id" property="id"/>
        <result column="version_id" property="versionId"/>
        <result column="chain_code" property="chainCode"/>
        <result column="node_id" property="nodeId"/>
        <result column="node_code" property="nodeCode"/>
        <result column="node_name" property="nodeName"/>
        <result column="node_type" property="nodeType"/>
        <result column="sort_no" property="sortNo"/>
        <result column="parallel_group" property="parallelGroup"/>
        <result column="request_url" property="requestUrl"/>
        <result column="request_method" property="requestMethod"/>
        <result column="request_headers" property="requestHeaders"/>
        <result column="body_type" property="bodyType"/>
        <result column="body_data" property="bodyData"/>
        <result column="response_code" property="responseCode"/>
        <result column="response_headers" property="responseHeaders"/>
        <result column="response_body" property="responseBody"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="batchInsert">
        INSERT INTO test_node_snapshot (version_id, chain_code, node_id, node_code, node_name, node_type, sort_no, parallel_group, request_url, request_method, request_headers, body_type, body_data, response_code, response_headers, response_body, duration_ms)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.versionId}, #{item.chainCode}, #{item.nodeId}, #{item.nodeCode}, #{item.nodeName}, #{item.nodeType}, #{item.sortNo}, #{item.parallelGroup}, #{item.requestUrl}, #{item.requestMethod}, #{item.requestHeaders}, #{item.bodyType}, #{item.bodyData}, #{item.responseCode}, #{item.responseHeaders}, #{item.responseBody}, #{item.durationMs})
        </foreach>
    </insert>

    <select id="selectByVersionId" resultMap="BaseResultMap">
        SELECT * FROM test_node_snapshot
        WHERE version_id = #{versionId}
        ORDER BY sort_no ASC
    </select>

    <delete id="deleteByVersionId">
        DELETE FROM test_node_snapshot WHERE version_id = #{versionId}
    </delete>
</mapper>
