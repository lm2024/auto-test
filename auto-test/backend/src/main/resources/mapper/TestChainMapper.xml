<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autotest.mapper.TestChainMapper">

    <resultMap id="BaseResultMap" type="com.autotest.model.entity.TestChain">
        <id column="id" property="id"/>
        <result column="chain_code" property="chainCode"/>
        <result column="chain_name" property="chainName"/>
        <result column="execute_mode" property="executeMode"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="status" property="status"/>
        <result column="graph_data" property="graphData"/>
        <result column="biz_oper_trace_id" property="bizOperTraceId"/>
        <result column="account_code" property="accountCode"/>
        <result column="system_category" property="systemCategory"/>
        <result column="func_category" property="funcCategory"/>
        <result column="priority" property="priority"/>
        <result column="category_id" property="categoryId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="product_code" property="productCode"/>
        <result column="login_chain_code" property="loginChainCode"/>
        <result column="login_timeout" property="loginTimeout"/>
        <result column="data_pool_code" property="dataPoolCode"/>
        <result column="param_mode" property="paramMode"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO test_chain (chain_code, chain_name, execute_mode, description, create_by, status, graph_data,
            biz_oper_trace_id, account_code, system_category, func_category, priority, category_id, tenant_id,
            product_code, login_chain_code, login_timeout, data_pool_code, param_mode)
        VALUES (#{chainCode}, #{chainName}, #{executeMode}, #{description}, #{createBy}, #{status}, #{graphData},
            #{bizOperTraceId}, #{accountCode}, #{systemCategory}, #{funcCategory}, #{priority}, #{categoryId}, #{tenantId},
            #{productCode}, #{loginChainCode}, #{loginTimeout}, #{dataPoolCode}, #{paramMode})
    </insert>

    <update id="update">
        UPDATE test_chain
        <set>
            <if test="chainName != null">chain_name = #{chainName},</if>
            <if test="executeMode != null">execute_mode = #{executeMode},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="graphData != null">graph_data = #{graphData},</if>
            <if test="bizOperTraceId != null">biz_oper_trace_id = #{bizOperTraceId},</if>
            <if test="accountCode != null">account_code = #{accountCode},</if>
            <if test="systemCategory != null">system_category = #{systemCategory},</if>
            <if test="funcCategory != null">func_category = #{funcCategory},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
            <if test="productCode != null">product_code = #{productCode},</if>
            <if test="loginChainCode != null">login_chain_code = #{loginChainCode},</if>
            <if test="loginTimeout != null">login_timeout = #{loginTimeout},</if>
            <if test="dataPoolCode != null">data_pool_code = #{dataPoolCode},</if>
            <if test="paramMode != null">param_mode = #{paramMode},</if>
        </set>
        WHERE chain_code = #{chainCode}
    </update>

    <delete id="deleteByChainCode">
        DELETE FROM test_chain WHERE chain_code = #{chainCode}
    </delete>

    <select id="selectByChainCode" resultMap="BaseResultMap">
        SELECT * FROM test_chain WHERE chain_code = #{chainCode}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT * FROM test_chain
        <where>
            <if test="chainName != null and chainName != ''">
                AND chain_name LIKE CONCAT('%', #{chainName}, '%')
            </if>
            <if test="executeMode != null">
                AND execute_mode = #{executeMode}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectListByCategory" resultMap="BaseResultMap">
        SELECT * FROM test_chain
        <where>
            <if test="chainName != null and chainName != ''">
                AND chain_name LIKE CONCAT('%', #{chainName}, '%')
            </if>
            <if test="executeMode != null">
                AND execute_mode = #{executeMode}
            </if>
            <if test="systemCategories != null and systemCategories.size() > 0">
                AND system_category IN
                <foreach collection="systemCategories" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="funcCategories != null and funcCategories.size() > 0">
                AND func_category IN
                <foreach collection="funcCategories" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="priority != null">
                AND priority = #{priority}
            </if>
            <if test="categoryIds != null and categoryIds.size() > 0">
                AND category_id IN
                <foreach collection="categoryIds" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countByCategory" resultType="int">
        SELECT COUNT(*) FROM test_chain
        <where>
            <if test="chainName != null and chainName != ''">
                AND chain_name LIKE CONCAT('%', #{chainName}, '%')
            </if>
            <if test="executeMode != null">
                AND execute_mode = #{executeMode}
            </if>
            <if test="systemCategories != null and systemCategories.size() > 0">
                AND system_category IN
                <foreach collection="systemCategories" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="funcCategories != null and funcCategories.size() > 0">
                AND func_category IN
                <foreach collection="funcCategories" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="priority != null">
                AND priority = #{priority}
            </if>
            <if test="categoryIds != null and categoryIds.size() > 0">
                AND category_id IN
                <foreach collection="categoryIds" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>

    <select id="countByChainCode" resultType="int">
        SELECT COUNT(*) FROM test_chain WHERE chain_code = #{chainCode}
    </select>

    <select id="countByChainName" resultType="int">
        SELECT COUNT(*) FROM test_chain WHERE chain_name LIKE CONCAT('%', #{chainName}, '%')
    </select>
</mapper>
